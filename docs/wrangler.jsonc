// Cloudflare Workers Static Assets config for this project's documentation.
// Assets-only (no worker script); deployed by .github/workflows/docs.yml.
// Before deploying a fork, set name to your own worker name and set baseURL
// in hugo.yaml to its public HTTPS URL. See DEPLOYMENT.md for setup steps.
{
	"name": "sprout-docs",
	"compatibility_date": "2026-07-01",
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page"
	}
}
